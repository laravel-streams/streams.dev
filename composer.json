{
    "name": "laravel-streams/streams.dev",
    "type": "project",
    "description": "A modular ecosystem of Laravel packages (Core, UI, API, SDK) for building configurable, data-driven web applications and control panels.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^12.0",
        "laravel/mcp": "^1.0",
        "predis/predis": "^3.0",
        "streams/core": "dev-rc/prep as 2.0.x-dev",
        "streams/ui": "1.0.x-dev"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "spatie/laravel-ignition": "^2.0",
        "streams/sdk": "dev-sdk/rc as 1.0.x-dev"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laravel-streams/streams-core.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/laravel-streams/streams-ui.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/laravel-streams/streams-sdk.git",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#fb7185,#fdba74\" --names=server,logs,vite --kill-others \"php artisan serve --host=127.0.0.1 --port=8427\" \"php artisan pail --timeout=0\" \"npm run dev\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "streams/*": "source",
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "process-timeout": 0,
        "platform": {
            "php": "8.2.4"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
