{
    "name": "Posts",
    "handle": "posts",
    "description": "Fictional posts for UI playground examples.",
    "config": {
        "source": {
            "type": "filebase",
            "format": "json",
            "path": "streams/data/playground/posts"
        }
    },
    "fields": [
        {
            "handle": "id",
            "type": "string",
            "required": true,
            "unique": true
        },
        {
            "handle": "title",
            "type": "string",
            "required": true
        },
        {
            "handle": "slug",
            "type": "slug",
            "required": true
        },
        {
            "handle": "author",
            "type": "relationship",
            "config": {
                "related": "people"
            }
        },
        {
            "handle": "status",
            "type": "select",
            "config": {
                "options": {
                    "draft": "Draft",
                    "published": "Published",
                    "archived": "Archived"
                }
            }
        },
        {
            "handle": "body",
            "type": "string"
        },
        {
            "handle": "published_at",
            "type": "datetime"
        }
    ]
}
