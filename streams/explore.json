{
    "name": "Explore",
    "handle": "explore",
    "description": "Explore the features and operating principles of Laravel Streams.",
    "config": {
        "source": {
            "format": "md"
        }
    },
    "routes": [
        {
            "handle": "view",
            "uri": "explore/{id}",
            "view": "docs"
        }
    ],
    "fields": [
        {
            "handle": "id",
            "type": "slug",
            "required": true,
            "unique": true
        },
        {
            "handle": "sort_order",
            "type": "integer",
            "required": true,
            "config": {
                "default": "increment"
            }
        },
        {
            "handle": "title",
            "type": "string",
            "required": true
        },
        {
            "handle": "description",
            "type": "string",
            "input": {
                "type": "textarea"
            }
        },
        {
            "handle": "body",
            "type": "string",
            "input": {
                "type": "editor"
            }
        }
    ],
    "ui": {
        "admin": {
            "navigation": [
                {
                    "sort_order": 3,
                    "text": "Explore",
                    "url": "/admin/explore",
                    "component": "anchor"
                }
            ]
        }
    }
}
