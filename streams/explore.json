{
    "name": "Explore",
    "handle": "explore",
    "description": "A choose-your-path walk through Streams. Each node is one markdown file; front matter drives the choices.",
    "config": {
        "source": {
            "format": "md"
        }
    },
    "routes": [
        {
            "handle": "view",
            "uri": "explore/{id}",
            "view": "explore",
            "constraints": [
                {
                    "id": "[a-z0-9-]+"
                }
            ]
        }
    ],
    "fields": [
        {
            "handle": "id",
            "type": "slug",
            "required": true,
            "unique": true
        },
        {
            "handle": "sort_order",
            "type": "integer",
            "required": true,
            "config": {
                "default": "increment"
            }
        },
        {
            "handle": "title",
            "type": "string",
            "required": true
        },
        {
            "handle": "label",
            "type": "string",
            "input": {
                "placeholder": "Short name for breadcrumbs and <title>"
            }
        },
        {
            "handle": "description",
            "type": "string",
            "input": {
                "type": "textarea"
            }
        },
        {
            "handle": "parent",
            "type": "relationship",
            "config": {
                "related": "explore"
            }
        },
        {
            "handle": "menu",
            "type": "array"
        },
        {
            "handle": "options",
            "type": "array"
        },
        {
            "handle": "links",
            "type": "array"
        },
        {
            "handle": "body",
            "type": "string",
            "input": {
                "type": "editor"
            }
        }
    ],
    "ui": {
        "admin": {
            "navigation": [
                {
                    "sort_order": 3,
                    "text": "Explore",
                    "url": "/admin/explore",
                    "component": "anchor"
                }
            ]
        }
    }
}
