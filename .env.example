APP_NAME="Streams"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# `composer dev` serves the app on 8427 and Vite (dev server + HMR) on 5427.
APP_URL=http://127.0.0.1:8427

STREAMS_CP_ENABLED=true
STREAMS_API_ENABLED=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Deployment (Envoy.blade.php). Only needed to deploy with `envoy run deploy`.
# DEPLOY_SERVER       SSH target, e.g. user@host
# DEPLOY_REPOSITORY   git URL the server clones and pulls
# DEPLOY_PATH         absolute path of the app on the server (must start with /)
# DEPLOY_PHP_BINARY   PHP binary on the server (defaults to `php`)
# DEPLOY_HEALTH_CHECK URL that must answer 200 after a deploy (optional)
# Envoy also reads DEPLOY_COMPOSER_BINARY, DEPLOY_SLACK_WEBHOOK and
# DEPLOY_DEFAULT_BRANCH (the branch deploy fast-forwards to; default master).
DEPLOY_SERVER=
DEPLOY_REPOSITORY=
DEPLOY_PATH=
DEPLOY_PHP_BINARY=
DEPLOY_HEALTH_CHECK=
